IndentWidth: 3
TabWidth: 3
UseTab: true
ColumnLimit: 0

ObjCSpaceAfterProperty: true
# Brace style
BreakBeforeBraces: Allman              # { on new line for methods

# ObjC specific
ObjCBinPackProtocolList: Never
BinPackParameters: true                # don't break long param lists unnaturally

# Line breaking
BreakBeforeBinaryOperators: None
AlwaysBreakBeforeMultilineStrings: false
PenaltyBreakBeforeFirstCallParameter: 1000000   # discourage breaking method calls

# if( without space
SpaceBeforeParens: Never               # no space before ANY paren — matches if( style

# Alignment
AlignConsecutiveAssignments:
  Enabled: true
  AcrossEmptyLines: false
  AcrossComments: false